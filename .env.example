# InsightVision Backend Environment
# Copy this file to .env and fill in real values

GROQ_API_KEY=your_groq_api_key_here

# Server port (default 8000)
PORT=8000

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Copy this line to frontend/.env.local for local dev.
# In Vercel: set VITE_API_URL in Dashboard → Settings → Environment Variables.
# NEVER commit the real Tailscale URL to source control.
VITE_API_URL=http://localhost:8000

